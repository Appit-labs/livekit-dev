# The public domain for this server (e.g. livekit.example.com — no scheme, no trailing slash)
LIVEKIT_DOMAIN=

# LiveKit server API keys — format: "your-key: your-secret" (YAML key-value, space after colon)
# Generate a key pair with: docker run --rm livekit/livekit-server generate-keys
# Use the same key and secret in your backend's LIVEKIT_API_KEY and LIVEKIT_API_SECRET env vars
LIVEKIT_KEYS=

# Optional: email for Let's Encrypt certificate expiry notifications (used by Caddy)
ACME_EMAIL=
